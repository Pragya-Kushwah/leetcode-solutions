class Solution {
public:
    void reverseStr(vector<char>& s,int left, int right) {
        if(left>=right){
            return;
        }
            char temp = s[left];
            s[left]=s[right];
            s[right]=temp;
            reverseStr(s,left + 1, right - 1);
        }
        void reverseString(vector<char>& s){
            reverseStr(s,0,s.size()-1);
        }
    
};
