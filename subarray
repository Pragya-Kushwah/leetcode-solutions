class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int sum = 0;

        for(int i = 0; i < k; i++) {
            sum += nums[i];
        }

        double currAvg = (double)sum / k;
        double maxAvg = currAvg;

        for(int i = k; i < nums.size(); i++) {
            sum = sum - nums[i - k] + nums[i];

            currAvg = (double)sum / k;

            if(currAvg >= maxAvg) {
                maxAvg = currAvg;
            }
        }

        return maxAvg;
    }
};
