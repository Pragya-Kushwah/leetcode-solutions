class Solution {
public:
    int thirdMax(vector<int>& nums) {
        int firstMax = INT_MIN;
        int secondMax = INT_MIN;
        int thirdMax = INT_MIN;

        for(int i = 0; i < nums.size(); i++) {

            if(nums[i] > firstMax) {
                int oldFirstMax = firstMax;
                int oldSecondMax = secondMax;

                firstMax = nums[i];
                secondMax = oldFirstMax;
                thirdMax = oldSecondMax;
            }
            else if(nums[i] > secondMax && nums[i] != firstMax) {
                int oldSecondMax = secondMax;

                secondMax = nums[i];
                thirdMax = oldSecondMax;
            }
            else if(nums[i] > thirdMax &&
                    nums[i] != firstMax &&
                    nums[i] != secondMax) {
                thirdMax = nums[i];
            }
        }

        if(thirdMax == INT_MIN) {
            return firstMax;
        }

        return thirdMax;
    }
};
