class Solution {
  public:
    string sortString(string &s) {
        vector<int> freq(26, 0);

        for(int i = 0; i < s.length(); i++) {
            freq[s[i] - 'a']++;
        }

        string result = "";

        for(int i = 0; i < 26; i++) {
            while(freq[i] > 0) {
                result += char(i + 'a');
                freq[i]--;
            }
        }

        return result;
    }
};
