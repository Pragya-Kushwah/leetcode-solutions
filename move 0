class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int left = 0;

        // Move all non-zero elements to the front
        for(int i = 0; i < nums.size(); i++)
        {
            if(nums[i] != 0)
            {
                nums[left] = nums[i];
                left++;
            }
        }

        // Fill remaining positions with 0
        for(int i = left; i < nums.size(); i++)
        {
            nums[i] = 0;
        }
    }
};
