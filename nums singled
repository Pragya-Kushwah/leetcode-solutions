class Solution {
public:
    int singleNumber(vector<int>& nums) {
        vector<int> freq(10001, 0);

        // First loop: Count frequency
        for (int i = 0; i < nums.size(); i++) {
            freq[nums[i]]++;
        }

        // Second loop: Find the element appearing once
        for (int i = 0; i < nums.size(); i++) {
            if (freq[nums[i]] == 1) {
                return nums[i];
            }
        }

        return -1;
    }
};
