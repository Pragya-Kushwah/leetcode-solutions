class Solution {
public:
    bool isIsomorphic(string s, string t) {
        unordered_map<char, char> mp;
        unordered_map<char, char> reverse;

        for (int i = 0; i < s.length(); i++) {

            if (mp.find(s[i]) != mp.end()) {
                if (mp[s[i]] != t[i])
                    return false;
            }
            else {
                mp[s[i]] = t[i];
            }

            if (reverse.find(t[i]) != reverse.end()) {
                if (reverse[t[i]] != s[i])
                    return false;
            }
            else {
                reverse[t[i]] = s[i];
            }
        }

        return true;
    }
};
