
class Solution {
public:
    void rotate(vector<int>& nums, int k) {
        int right = nums.size() - 1;

        k = k % nums.size();

        for (int i = 0; i < k; i++) {
            for (int j = right; j > 0; j--) {
                swap(nums[j], nums[j - 1]);
            }
        }
    }
};
