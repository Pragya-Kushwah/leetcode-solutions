class Solution {
public:
    vector<int> maximumWeight(vector<vector<int>>& intervals) {

        int n = intervals.size();

        // Store: start, end, weight, original index
        vector<array<long long, 4>> a;

        for (int i = 0; i < n; i++) {
            a.push_back({
                intervals[i][0],
                intervals[i][1],
                intervals[i][2],
                i
            });
        }

        // Sort by start time
        sort(a.begin(), a.end());

        // dp[i][k] = best answer starting from i
        // when we can still select k intervals
        vector<vector<pair<long long, vector<int>>>> dp(
            n + 1,
            vector<pair<long long, vector<int>>>(5)
        );

        // Find first interval whose start > current end
        auto getNext = [&](int i) {

            int lo = i + 1;
            int hi = n;

            while (lo < hi) {

                int mid = lo + (hi - lo) / 2;

                if (a[mid][0] > a[i][1])
                    hi = mid;
                else
                    lo = mid + 1;
            }

            return lo;
        };

        for (int k = 0; k <= 4; k++) {
            dp[n][k] = {0, {}};
        }

        for (int i = n - 1; i >= 0; i--) {

            for (int k = 1; k <= 4; k++) {

                // Option 1: Skip current interval
                auto skip = dp[i + 1][k];

                // Option 2: Take current interval
                int nxt = getNext(i);

                auto take = dp[nxt][k - 1];

                take.first += a[i][2];
                take.second.push_back(a[i][3]);

                // Choose better score
                if (take.first > skip.first) {
                    dp[i][k] = take;
                }
                else if (take.first < skip.first) {
                    dp[i][k] = skip;
                }
                else {
                    // If same score, choose lexicographically smaller indices
                    sort(take.second.begin(), take.second.end());
                    sort(skip.second.begin(), skip.second.end());

                    dp[i][k] = min(take, skip);
                }
            }
        }

        vector<int> ans = dp[0][4].second;

        sort(ans.begin(), ans.end());

        return ans;
    }
};
